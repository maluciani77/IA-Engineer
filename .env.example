# Proveedor por defecto: openai | anthropic
LLM_PROVIDER=openai

# Claves de API (solo hace falta la del proveedor que vayas a usar)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Modelo por proveedor (opcional; si se omite se usa el default del codigo)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5-5

# Parametros de generacion (opcionales)
# temperature y top_p los usa OpenAI; effort lo usa Anthropic.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
# low | medium | high | xhigh | max
LLM_EFFORT=medium
